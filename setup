                <div class="slider-header"><label style="font-size:12px;">Technical Depth</label><span id="w_technical_label" style="font-size:12px;color:var(--green);font-weight:600;">35%</span></div>
                <input type="range" id="w_technical" min="0" max="100" value="35" oninput="updateWeights('w_technical')">
            </div>
            <div class="slider-item">
                <div class="slider-header"><label style="font-size:12px;">Strategic Thinking</label><span id="w_strategic_label" style="font-size:12px;color:var(--green);font-weight:600;">30%</span></div>
                <input type="range" id="w_strategic" min="0" max="100" value="30" oninput="updateWeights('w_strategic')">
            </div>
            <div class="slider-item">
                <div class="slider-header"><label style="font-size:12px;">Communication</label><span id="w_communication_label" style="font-size:12px;color:var(--green);font-weight:600;">25%</span></div>
                <input type="range" id="w_communication" min="0" max="100" value="25" oninput="updateWeights('w_communication')">
            </div>
            <div class="slider-item">
                <div class="slider-header"><label style="font-size:12px;">Cross-Functional</label><span id="w_cross_label" style="font-size:12px;color:var(--green);font-weight:600;">10%</span></div>
                <input type="range" id="w_cross" min="0" max="100" value="10" oninput="updateWeights('w_cross')">
            </div>
        </div>
        <p class="weights-warn" id="weightsWarn">⚠️ Weights must total 100%</p>
