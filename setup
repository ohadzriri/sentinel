<script>
    const SUPABASE_URL = 'https://tkgzbxkvoufvyodidaof.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRrZ3pieGt2b3VmdnlvZGlkYW9mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUxNjM2NTMsImV4cCI6MjEwMDczOTY1M30.fKXpmmMvCILS6fZMVVWmdJOBDG4kmcuBADPWelkrBQ8';

    function toggleSwitch(btnId, inputId) {
        const btn = document.getElementById(btnId);
        const input = document.getElementById(inputId);
        const isOn = btn.classList.contains('on');
        if (isOn) { btn.classList.remove('on'); input.value = 'false'; }
        else { btn.classList.add('on'); input.value = 'true'; }
    }

    function updateWeights(changedId) {
        const ids = ['w_technical','w_strategic','w_communication','w_cross'];
        const others = ids.filter(id => id !== changedId);
        const changedVal = parseInt(document.getElementById(changedId).value);
        const othersSum = others.reduce((s,id) => s + parseInt(document.getElementById(id).value), 0);
        if (changedVal + othersSum > 100) {
            document.getElementById(changedId).value = 100 - othersSum;
        }
        const vals = ids.map(id => parseInt(document.getElementById(id).value));
        const total = vals.reduce((a,b) => a+b, 0);
        ['technical','strategic','communication','cross'].forEach((k,i) => {
            document.getElementById('w_'+k+'_label').textContent = vals[i] + '%';
        });
        document.getElementById('weightsTotal').textContent = total + '%';
        document.getElementById('weightsTotal').style.color = total === 100 ? 'var(--green)' : 'var(--danger)';
        document.getElementById('weightsWarn').style.display = total !== 100 ? 'block' : 'none';
    }

    async function generateWeights(key, jd) {
        try {
            const res = await fetch('https://api.openai.com/v1/chat/completions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key },
                body: JSON.stringify({
                    model: 'gpt-3.5-turbo',
                    messages: [{
                        role: 'system',
                        content: 'Analyze the job description and suggest percentage weights for 4 scoring categories. Return ONLY valid JSON: {"technical":<0-100>,"strategic":<0-100>,"communication":<0-100>,"cross":<0-100>}. Sum must equal exactly 100.'
                    }, {
                        role: 'user',
                        content: 'JD:\n' + jd.substring(0, 1500)
                    }],
                    temperature: 0.3
                })
            });
            const data = await res.json();
            const text = data.choices[0].message.content;
            const json = JSON.parse(text.substring(text.indexOf('{'), text.lastIndexOf('}') + 1));
            const sum = json.technical + json.strategic + json.communication + json.cross;
            return {
                technical: Math.round(json.technical * 100 / sum),
                strategic: Math.round(json.strategic * 100 / sum),
                communication: Math.round(json.communication * 100 / sum),
                cross: Math.round(json.cross * 100 / sum)
            };
        } catch(e) {
            return { technical: 35, strategic: 30, communication: 25, cross: 10 };
        }
    }

    async function generateQuestions(key, jd, companyName, questionCount, depthLevel) {
        const companyContext = companyName
            ? `\n\nCOMPANY CONTEXT: The role is at "${companyName}". Use your knowledge about this company to make scenarios specific to THIS company.`
            : '';

        const depthInstruction = depthLevel === 'indepth'
            ? `\nDEPTH: IN-DEPTH. Use your knowledge of what this role ACTUALLY involves. Name specific tools, commands, metrics. A generic answer should not score well.\n\nEXAMPLE of good in-depth question (MongoDB CSM): "A Fortune 500 client on Atlas reports 1,800ms read latency. Their 3-node replica set primary is at 94% CPU. Atlas Performance Advisor flags a missing compound index. The CTO asks whether the issue is read preference (primaryPreferred), missing index, or M50→M80 upgrade. Board meeting in 6 hours. What is your diagnostic approach?"`
            : `\nDEPTH: SCREENING. Test thinking frameworks and communication. Focus on how they approach problems.`;

        const systemPrompt = `Generate exactly ${questionCount} interview case questions.${companyContext}${depthInstruction}

RULES:
- Reference specific JD responsibilities
- Include at least 2 pressure elements (dollar amount, deadline, named stakeholder)
- End each question with: "This question tests:\n• skill1\n• skill2\n• skill3"

Return ONLY a JSON array: [{"title":"Phase 1: Label","question":"Full scenario..."}]`;

        const res = await fetch('https://api.openai.com/v1/chat/completions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key },
            body: JSON.stringify({
                model: depthLevel === 'indepth' ? 'gpt-4o-mini' : 'gpt-3.5-turbo',
                messages: [{ role: 'system', content: systemPrompt }, { role: 'user', content: 'JD:\n' + jd + (companyName ? '\nCompany: ' + companyName : '') }],
                temperature: 0.7
            })
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error.message);
        const content = data.choices[0].message.content;
        const jsonStr = content.substring(content.indexOf('['), content.lastIndexOf(']') + 1);
        return JSON.parse(jsonStr.replace(/[\u0000-\u001F\u007F-\u009F]/g, ' '));
    }

    async function generateScreening(key, jd) {
        const systemPrompt = `Generate exactly 5 screening questions to assess candidate fit for this role.
Mix of types: 3 open-ended text questions + 2 yes/no questions.
Focus on: experience, past achievements, specific skills mentioned in JD.
Return ONLY JSON array: [{"question":"...","type":"text"}, {"question":"...","type":"yesno"}]`;

        const res = await fetch('https://api.openai.com/v1/chat/completions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key },
            body: JSON.stringify({
                model: 'gpt-3.5-turbo',
                messages: [{ role: 'system', content: systemPrompt }, { role: 'user', content: 'JD:\n' + jd }],
                temperature: 0.5
            })
        });
        const data = await res.json();
        const content = data.choices[0].message.content;
        const jsonStr = content.substring(content.indexOf('['), content.lastIndexOf(']') + 1);
        return JSON.parse(jsonStr.replace(/[\u0000-\u001F\u007F-\u009F]/g, ' '));
    }

    async function saveToSupabase(sessionData) {
        const res = await fetch(SUPABASE_URL + '/rest/v1/sessions', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'apikey': SUPABASE_KEY,
                'Authorization': 'Bearer ' + SUPABASE_KEY,
                'Prefer': 'return=representation'
            },
            body: JSON.stringify(sessionData)
        });
        const data = await res.json();
        if (!res.ok) throw new Error(JSON.stringify(data));
        return data[0];
    }

    async function createAssessment() {
        const key = document.getElementById('apiKey').value.trim();
        const hrEmail = document.getElementById('hrEmail').value.trim();
        const jd = document.getElementById('jdInput').value.trim();
        const companyName = document.getElementById('companyName').value.trim();
        const questionCount = parseInt(document.querySelector('input[name="questionCount"]:checked')?.value || '3');
        const depthLevel = document.querySelector('input[name="depthLevel"]:checked')?.value || 'screening';

        if (!key) return alert('Please enter your OpenAI API key.');
        if (!hrEmail || !hrEmail.includes('@')) return alert('Please enter a valid HR email.');
        if (!jd) return alert('Please paste the job description.');

        const wTotal = ['w_technical','w_strategic','w_communication','w_cross'].reduce((s,id) => s + parseInt(document.getElementById(id).value), 0);
        if (wTotal !== 100) return alert('Score weights must total 100%.');

        document.getElementById('generateBtn').disabled = true;
        document.getElementById('loading').style.display = 'block';
        document.getElementById('resultBox').style.display = 'none';

        try {
            const [questions, screeningQuestions, weights] = await Promise.all([
                generateQuestions(key, jd, companyName, questionCount, depthLevel),
                generateScreening(key, jd),
                generateWeights(key, jd)
            ]);

            // Apply AI weights to sliders
            document.getElementById('w_technical').value = weights.technical;
            document.getElementById('w_strategic').value = weights.strategic;
            document.getElementById('w_communication').value = weights.communication;
            document.getElementById('w_cross').value = weights.cross;
            updateWeights('w_technical');
            document.getElementById('weightsNote').textContent = '(AI suggested — adjust if needed)';

            const settings = {
                depthLevel,
                questionCount,
                pastePenalty: parseInt(document.getElementById('paste_penalty').value),
                tabPenalty: parseInt(document.getElementById('tab_penalty').value),
                screeningMandatory: document.getElementById('screeningMandatory').value === 'true',
                cameraEnabled: document.getElementById('cameraEnabled').value === 'true',
                weights: {
                    technical: parseInt(document.getElementById('w_technical').value),
                    strategic: parseInt(document.getElementById('w_strategic').value),
                    communication: parseInt(document.getElementById('w_communication').value),
                    cross: parseInt(document.getElementById('w_cross').value)
                }
            };

            const session = await saveToSupabase({
                jd,
                company_name: companyName,
                questions,
                screening_questions: screeningQuestions,
                settings,
                hr_email: hrEmail,
                openai_key: key
            });

            const assessmentUrl = window.location.href.replace('setup.html', 'assessment.html') + '?session=' + session.id;

            document.getElementById('resultLink').textContent = assessmentUrl;
            document.getElementById('resultEmail').textContent = hrEmail;
            document.getElementById('resultBox').style.display = 'block';
            document.getElementById('loading').style.display = 'none';

        } catch(err) {
            alert('Error: ' + err.message);
            document.getElementById('loading').style.display = 'none';
            document.getElementById('generateBtn').disabled = false;
        }
    }

    function copyLink() {
        const link = document.getElementById('resultLink').textContent;
        navigator.clipboard.writeText(link).then(() => {
            const btn = document.querySelector('.copy-btn');
            btn.textContent = '✓ Copied!';
            setTimeout(() => btn.textContent = '📋 Copy Link', 2000);
        });
    }

    function createAnother() {
        document.getElementById('resultBox').style.display = 'none';
        document.getElementById('generateBtn').disabled = false;
        document.getElementById('jdInput').value = '';
        document.getElementById('companyName').value = '';
    }
</script>
</body>
</html>
